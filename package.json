{
  "name": "unit-tests-jest",
  "version": "1.0.0",
  "description": "Example to unit tests using Jest",
  "main": "index.js",
  "author": "ugioni",
  "license": "ISC",
  "dependencies": {
    "jest": "^30.4.2",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "clean": "rimraf ./coverage && mkdirp ./coverage",
    "test": "npm run clean && jest",
    "coverage": "npm run clean && jest --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ]
  },
  "devDependencies": {
    "pactum": "^3.9.1",
    "supertest": "^7.3.1"
  }
}
